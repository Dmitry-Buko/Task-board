{
  "mcp": {
    "servers": {
      "github": {
        "type": "stdio",
        "command": "C:\\Users\\HP ZBook 17 G3\\.zcode\\mcp\\github-mcp-server.exe",
        "args": ["stdio", "--toolsets", "issues,repos", "--read-only"]
      }
    }
  },
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": ["${ZCODE_PROJECT_DIR}/.zcode/hooks/protect-file.cjs"]
            },
            {
              "type": "process",
              "command": "node",
              "args": ["${ZCODE_PROJECT_DIR}/.zcode/hooks/protect-legacy.cjs"]
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": ["${ZCODE_PROJECT_DIR}/.zcode/hooks/check-edited-file.cjs"]
            }
          ]
        }
      ]
    }
  }
}
